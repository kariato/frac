{
  "name": "frac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A spatial falling-block puzzle for desktop and touch screens",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "format": "prettier --write src tests scripts *.ts *.json *.md .github",
    "format:check": "prettier --check src tests scripts *.ts *.json *.md .github"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
